{
  "name": "nanogres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "link": "node ../panel-frame-ui/scripts/link-local.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "health": "repnix check --details",
    "health:audit": "repnix audit",
    "health:plan": "repnix setup --plan --format json",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:styles": "stylelint \"src/**/*.module.css\""
  },
  "dependencies": {
    "next": "^16.4.1",
    "panel-frame-ui": "^0.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "ui-preview-kit": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "repnix": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  }
}
